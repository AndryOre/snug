{
  "name": "snug",
  "description": "Export, import, and schedule automatic exports of your bookmarks — six formats, duplicate cleanup, and undo, all on your device, no account, no cloud.",
  "keywords": [
    "browser-extension",
    "bookmarks",
    "backup",
    "export",
    "import",
    "csv",
    "markdown",
    "opml",
    "xbel",
    "duplicates",
    "chrome",
    "wxt"
  ],
  "homepage": "https://github.com/AndryOre/snug",
  "bugs": {
    "url": "https://github.com/AndryOre/snug/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndryOre/snug.git"
  },
  "license": "MIT",
  "author": "Andry Orellana <me@andryore.dev>",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "^19.2.5",
      "react-dom": "^19.2.5",
      "typescript": "^6.0.3",
      "tailwindcss": "^4.2.4",
      "@tailwindcss/vite": "^4.2.4",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "lucide-react": "^1.49.0",
      "cn": "^0.4.0",
      "vitest": "^5.0.3",
      "@types/bun": "^1.4.2"
    }
  },
  "scripts": {
    "clean": "rm -rf apps/extension/.output apps/extension/.wxt apps/extension/node_modules apps/video/node_modules apps/site/node_modules apps/site/dist apps/site/.astro packages/ui/node_modules .turbo node_modules",
    "cache:clear": "rm -rf .eslintcache .turbo node_modules/.cache",
    "dev": "bun run --cwd apps/extension dev",
    "build": "turbo run build",
    "zip": "turbo run zip",
    "check": "turbo run check check:root",
    "fix": "bun run format:write && bun run lint:fix && bun run typecheck",
    "ci:local": "bun install --frozen-lockfile && bun run check && bun run lint:docs && bun run test",
    "typecheck": "tsc --noEmit && bun run --cwd packages/ui check && bun run --cwd apps/extension check && bun run --cwd apps/video check && bun run --cwd apps/site check",
    "brand:export": "bun docs/brand/tools/export.mjs",
    "env:encrypt": "bunx --bun dotenvx encrypt -f .env",
    "knip": "bunx knip",
    "lint": "bunx eslint . --max-warnings=0 --cache --cache-strategy content",
    "lint:docs": "bun scripts/lint-docs.ts",
    "lint:fix": "bunx eslint . --fix --max-warnings=0 --cache --cache-strategy content",
    "format:check": "bunx --bun prettier --check \"**/*.{ts,tsx,js,jsx,mjs,mdx,json,json5,md,css,scss,yml,yaml}\" --cache",
    "format:write": "bunx --bun prettier --write \"**/*.{ts,tsx,js,jsx,mjs,mdx,json,json5,md,css,scss,yml,yaml}\" --cache",
    "test": "turbo run test test:root",
    "test:coverage": "turbo run test:coverage test:root",
    "test:watch": "bun run --cwd apps/extension test:watch",
    "test:e2e": "turbo run test:e2e",
    "store:screenshots": "bun run --cwd apps/extension store:screenshots",
    "video:studio": "bun run --cwd apps/video studio",
    "video:still": "bun run --cwd apps/video still",
    "video:render": "bun run --cwd apps/video render",
    "video:thumbnails": "bun run --cwd apps/video thumbnails",
    "prepare": "bunx --bun husky",
    "check:root": "bun run format:check && bun run lint && tsc --noEmit && bun run knip",
    "test:root": "vitest run"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@dotenvx/dotenvx": "^2.30.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@shadcn/lint": "^0.2.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/bun": "catalog:",
    "@vitest/eslint-plugin": "^1.6.27",
    "bun-types": "^1.4.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsdoc": "^65.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^76.0.0",
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "lint-staged": "^17.5.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.0",
    "vitest": "catalog:"
  }
}
