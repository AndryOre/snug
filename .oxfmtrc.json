{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "all",
  "semi": false,
  "tabWidth": 2,
  "singleQuote": true,
  "printWidth": 80,
  "proseWrap": "always",
  "endOfLine": "lf",
  "arrowParens": "always",
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./packages/ui/src/styles/globals.css",
    "functions": ["cn", "cva", "clsx"]
  },
  "astro": {},
  "associations": [
    {
      "files": ["*.astro"],
      "language": "astro"
    }
  ],
  "ignorePatterns": [
    "node_modules",
    ".output",
    ".wxt",
    "bun.lock",
    "public/",
    "coverage",
    ".claude/skills/*",
    "!.claude/skills/migrate-radix-to-base/",
    "!.claude/skills/shadcn/",
    "apps/video/out",
    "apps/site/dist",
    "apps/site/.astro",
    "apps/site/src/content/playground-samples"
  ],
  "sortImports": {
    "groups": [
      ["builtin", "external", "unknown", "astro"],
      "internal",
      ["parent", "sibling", "index"]
    ],
    "internalPattern": ["@/"],
    "ignoreCase": true,
    "newlinesBetween": true,
    "customGroups": [
      {
        "groupName": "astro",
        "elementNamePattern": ["astro", "astro/**", "astro:*"]
      }
    ]
  }
}
