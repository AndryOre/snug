{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalDependencies": ["bun.lock", "tsconfig.base.json"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "check": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.output/**",
        "!.wxt/**",
        "!dist/**",
        "!.astro/**",
        "!coverage/**"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.output/**",
        "!.wxt/**",
        "!dist/**",
        "!.astro/**",
        "!coverage/**"
      ],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.output/**",
        "!.wxt/**",
        "!dist/**",
        "!.astro/**",
        "!coverage/**"
      ],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": ["PWDEBUG"]
    },
    "build": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.output/**",
        "!dist/**",
        "!.astro/**",
        "!coverage/**",
        "!e2e/**"
      ],
      "outputs": [".output/**", ".wxt/**", "dist/**", ".astro/**"]
    },
    "zip": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!.output/**",
        "!dist/**",
        "!.astro/**",
        "!coverage/**",
        "!e2e/**"
      ],
      "outputs": [".output/**", ".wxt/**", "dist/**", ".astro/**"]
    },
    "//#check:root": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!apps/*/.output/**",
        "!apps/*/.wxt/**",
        "!apps/*/dist/**",
        "!apps/*/.astro/**",
        "!**/coverage/**"
      ],
      "outputs": []
    },
    "//#test:root": {
      "inputs": ["scripts/**", "eslint-rules/**", "vitest.config.ts"],
      "outputs": []
    }
  }
}
