{
  "name": "@snug/extension",
  "description": "Export, import, and schedule automatic exports of your bookmarks \u2014 six formats, duplicate cleanup, and undo, all on your device, no account, no cloud.",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "wxt build && playwright test",
    "store:screenshots": "wxt build && playwright test -c playwright.store.config.ts",
    "postinstall": "wxt prepare",
    "clean": "rm -rf .output .wxt"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-virtual": "^3.14.13",
    "@wxt-dev/i18n": "^0.2.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/bun": "^1.4.2",
    "@types/chrome": "^0.3.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^5.0.3",
    "@wxt-dev/auto-icons": "^1.1.1",
    "@wxt-dev/browser": "^0.3.4",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.1.1",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}
