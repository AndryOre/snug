{
  "name": "@snug/extension",
  "description": "Export, import, and schedule automatic exports of your bookmarks — six formats, duplicate cleanup, and undo, all on your device, no account, no cloud.",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip && wxt zip -b edge",
    "check": "node ../../node_modules/typescript7/bin/tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "wxt build && playwright test",
    "store:screenshots": "wxt build && playwright test -c playwright.store.config.ts",
    "postinstall": "wxt prepare",
    "clean": "rm -rf .output .wxt"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-virtual": "^3.14.25",
    "@workspace/ui": "workspace:*",
    "@wxt-dev/i18n": "^0.2.8",
    "cn": "catalog:",
    "lucide-react": "catalog:",
    "papaparse": "^5.5.3",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@types/chrome": "^0.3.7",
    "@types/papaparse": "^5.5.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "^5.0.4",
    "@wxt-dev/auto-icons": "^1.1.1",
    "@wxt-dev/browser": "^0.3.7",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.1.3",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wxt": "^0.21.5"
  }
}
