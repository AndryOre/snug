{
  "extends": ["astro/tsconfigs/strict", "../../tsconfig.base.json"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "astro.config.ts",
    "playwright.config.ts",
    "playwright.container.config.ts",
    "vitest.config.ts",
    "e2e/**/*",
    "e2e-container/**/*",
    "src/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
