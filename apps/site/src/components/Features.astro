---
import { Badge } from '@workspace/ui/components/badge'
import { FEATURE_FORMATS, FEATURE_KEYS, getLandingCopy } from '../i18n/landing'
import type { Locale } from '../i18n/locales'
import CardGrid from './CardGrid.astro'
import NumberedCard from './NumberedCard.astro'
import Section from './Section.astro'

interface Props {
  locale: Locale
}

const { features } = getLandingCopy(Astro.props.locale)
---

<Section section="features" heading={features.heading} class="defer-render-md">
  <CardGrid as="ol">
    {FEATURE_KEYS.map((key, index) => (
      <NumberedCard
        numeral={String(index + 1).padStart(2, '0')}
        title={features.items[key].title}
        body={features.items[key].body}
      >
        {FEATURE_FORMATS[key] && (
          <ul class="flex flex-wrap gap-2" aria-hidden="true">
            {FEATURE_FORMATS[key].map((format) => (
              <li>
                <Badge variant="outline" className="font-mono" translate="no">
                  {format}
                </Badge>
              </li>
            ))}
          </ul>
        )}
      </NumberedCard>
    ))}
  </CardGrid>
</Section>
