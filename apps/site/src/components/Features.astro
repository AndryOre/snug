---
import { FEATURE_FORMATS, FEATURE_KEYS, getLandingCopy } from '../i18n/landing'
import type { Locale } from '../i18n/locales'
import CardGrid from './CardGrid.astro'
import NumberedCard from './NumberedCard.astro'
import Section from './Section.astro'

interface Props {
  locale: Locale
}

const { features } = getLandingCopy(Astro.props.locale)
---

<Section
  section="features"
  heading={features.heading}
  class="defer-render-md"
>
  <CardGrid as="ol">
    {
      FEATURE_KEYS.map((key, index) => (
        <NumberedCard
          numeral={String(index + 1).padStart(2, '0')}
          title={features.items[key].title}
          body={features.items[key].body}
        >
          {FEATURE_FORMATS[key] && (
            <ul class="mt-5 flex flex-wrap gap-2" aria-hidden="true">
              {FEATURE_FORMATS[key].map((format) => (
                <li class="rounded-md border border-border px-2 py-1 font-mono text-xs">
                  {format}
                </li>
              ))}
            </ul>
          )}
        </NumberedCard>
      ))
    }
  </CardGrid>
</Section>
