---
import csv from '../content/playground-samples/bookmarks.csv?raw'
import html from '../content/playground-samples/bookmarks.html?raw'
import json from '../content/playground-samples/bookmarks.json?raw'
import markdown from '../content/playground-samples/bookmarks.md?raw'
import opml from '../content/playground-samples/bookmarks.opml?raw'
import xbel from '../content/playground-samples/bookmarks.xbel?raw'
import { getContent } from '../i18n/content'
import type { Locale } from '../i18n/locales'
import { highlightSample } from '../scripts/highlight-sample'
import FormatPlayground from './FormatPlayground'
import Section from './Section.astro'

interface Props {
  locale: Locale
}

const { playground } = getContent(Astro.props.locale).landing
const samples = {
  html: { code: html, lang: 'html' },
  json: { code: json, lang: 'json' },
  csv: { code: csv, lang: 'csv' },
  markdown: { code: markdown, lang: 'markdown' },
  opml: { code: opml, lang: 'xml' },
  xbel: { code: xbel, lang: 'xml' },
} as const
const panes = await Promise.all(
  Object.entries(samples).map(async ([format, sample]) => ({
    format,
    ...(await highlightSample(sample.code.trimEnd(), sample.lang)),
  })),
)
const stylesheet = panes[0]?.css ?? ''
---

<Section
  section="playground"
  heading={playground.heading}
  lead={playground.subline}
>
  <FormatPlayground
    client:visible
    labels={playground.tabs}
    listLabel={playground.heading}
  >
    {panes.map((pane) => (
      <div slot={pane.format} set:html={pane.html} />
    ))}
  </FormatPlayground>
  {/* eslint-disable-next-line shadcn/no-inline-styles -- build-time generated syntax theme CSS, not hand-written styling */}
  <style is:global set:html={stylesheet} />
</Section>
