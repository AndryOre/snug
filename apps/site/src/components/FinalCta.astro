---
import { getClosingCopy } from '../i18n/landing'
import type { Locale } from '../i18n/locales'
import InstallButton from './InstallButton.astro'

interface Props {
  locale: Locale
}

const { final } = getClosingCopy(Astro.props.locale)
---

<section
  data-section="final"
  aria-labelledby="final-heading"
  class="bg-[radial-gradient(50rem_24rem_at_50%_100%,color-mix(in_oklch,var(--primary)_10%,transparent),transparent)]"
>
  <div class="mx-auto max-w-[1240px] px-4 py-14 md:px-14 md:py-24">
    <h2
      id="final-heading"
      class="max-w-3xl font-heading text-[clamp(1.875rem,4vw,3.25rem)] leading-[1.08] font-bold tracking-[-0.02em] text-balance"
    >
      {final.heading}
    </h2>
    <p
      class="mt-5 max-w-2xl text-[1.0625rem] leading-[1.55] text-muted-foreground"
    >
      {final.line}
    </p>
    <div class="mt-8">
      <InstallButton placement="final" label={final.button} />
    </div>
  </div>
</section>
