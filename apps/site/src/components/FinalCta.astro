---
import { getClosingCopy } from '../i18n/landing'
import type { Locale } from '../i18n/locales'
import InstallButton from './InstallButton.astro'
import Section from './Section.astro'

interface Props {
  locale: Locale
  heading?: string
  line?: string
  button?: string
}

const { locale, heading, line, button } = Astro.props
const { final } = getClosingCopy(locale)
---

<Section
  section="final"
  heading={heading ?? final.heading}
  lead={line ?? final.line}
  class="bg-final-cta-glow"
>
  <div class="mt-8">
    <InstallButton placement="final" label={button ?? final.button} />
  </div>
</Section>
