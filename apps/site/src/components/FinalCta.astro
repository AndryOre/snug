---
import { getClosingCopy } from '../i18n/landing'
import type { Locale } from '../i18n/locales'
import InstallButton from './InstallButton.astro'
import Section from './Section.astro'

interface Props {
  locale: Locale
}

const { final } = getClosingCopy(Astro.props.locale)
---

<Section
  section="final"
  heading={final.heading}
  lead={final.line}
  class="bg-final-cta-glow"
>
  <div class="mt-8">
    <InstallButton placement="final" label={final.button} />
  </div>
</Section>
