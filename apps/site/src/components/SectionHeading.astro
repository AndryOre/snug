---
import { cn } from '@workspace/ui/lib/utils'

interface Props {
  id?: string
  class?: string
}

const { id, class: className } = Astro.props
---

<h2
  id={id}
  class={cn(
    'max-w-3xl font-heading text-[clamp(1.875rem,4vw,3.25rem)] leading-[1.08] font-bold tracking-[-0.02em] break-words hyphens-auto text-balance',
    className,
  )}
>
  <slot />
</h2>
