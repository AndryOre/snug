---
import { cn } from '@workspace/ui/lib/utils'

interface Props {
  id?: string
  as?: 'h1' | 'h2'
  class?: string
}

const { id, as: Tag = 'h2', class: className } = Astro.props
---

<Tag
  id={id}
  class={cn(
    'max-w-3xl font-heading text-headline font-bold text-balance break-words phrase-break hyphens-auto',
    className,
  )}
>
  <slot />
</Tag>
