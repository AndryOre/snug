---
import { cn } from '@workspace/ui/lib/utils'

interface Props {
  id?: string
  class?: string
}

const { id, class: className } = Astro.props
---

<h2
  id={id}
  class={cn(
    'max-w-3xl font-heading text-headline font-bold break-words hyphens-auto text-balance',
    className,
  )}
>
  <slot />
</h2>
