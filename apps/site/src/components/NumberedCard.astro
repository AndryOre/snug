---
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from '@workspace/ui/components/card'
import Eyebrow from './Eyebrow.astro'

interface Props {
  numeral: string
  title: string
  body: string
}

const { numeral, title, body } = Astro.props
const hasExtras = Astro.slots.has('default')
---

<li class="flex">
  <Card size="lg" className="w-full">
    <CardHeader>
      <Eyebrow as="span" aria-hidden="true">
        {numeral}
      </Eyebrow>
      <CardTitle
        role="heading"
        aria-level={3}
        className="mt-3 text-2xl leading-tight break-words hyphens-auto"
      >
        {title}
      </CardTitle>
      <CardDescription className="mt-3 text-base">{body}</CardDescription>
    </CardHeader>
    {hasExtras && (
      <CardContent>
        <slot />
      </CardContent>
    )}
  </Card>
</li>
