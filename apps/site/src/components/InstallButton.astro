---
import { buttonVariants } from '@workspace/ui/components/button'
import { cn } from '@workspace/ui/lib/utils'

import { installHref, type InstallPlacement } from '../i18n/landing'

interface Props {
  placement: InstallPlacement
  label: string
}

const { placement, label } = Astro.props
---

{/* eslint-disable-next-line react/jsx-no-target-blank -- rel="noopener" is the spec; noreferrer would strip the referer the install redirect tags */}
<a
  href={installHref(placement)}
  target="_blank"
  rel="noopener"
  data-install={placement}
  data-umami-event="install"
  data-umami-event-placement={placement}
  class={cn(
    buttonVariants({ size: 'xl' }),
    'motion-safe:hover:-translate-y-px',
    'focus-ring-solid hover:bg-primary-hover',
  )}
>
  {label}
</a>
