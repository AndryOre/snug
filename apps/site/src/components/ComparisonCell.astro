---
import type { FactCell } from '../i18n/comparison-table'
import { DEFAULT_LOCALE, languageTag, type Locale } from '../i18n/locales'

interface Props {
  cell: FactCell
  locale: Locale
  notListed: string
  none: string
  noneDeclared: string
}

const { cell, locale, notListed, none, noneDeclared } = Astro.props
const isEnglishText =
  cell.kind === 'text' && cell.isEnglish === true && locale !== DEFAULT_LOCALE
---

{cell.kind === 'not-listed' && (
  <span class="text-muted-foreground italic">{notListed}</span>
)}
{cell.kind === 'yes' && <span translate="no">✓</span>}
{cell.kind === 'none' && (
  <>
    <span aria-hidden="true" translate="no">
      —
    </span>
    <span class="sr-only">{none}</span>
  </>
)}
{cell.kind === 'none-declared' && <span>{noneDeclared}</span>}
{cell.kind === 'text' && (
  <span lang={isEnglishText ? languageTag(DEFAULT_LOCALE) : undefined}>
    {cell.text}
  </span>
)}
