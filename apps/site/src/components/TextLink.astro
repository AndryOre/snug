---
import { cn } from '@workspace/ui/lib/utils'

interface Props {
  href: string
  class?: string
  [attribute: string]: unknown
}

const { href, class: className, ...rest } = Astro.props
---

<a
  href={href}
  class={cn(
    'inline-flex min-h-11 min-w-11 items-center rounded-md text-foreground underline decoration-muted-foreground underline-offset-4 hover:decoration-primary focus-ring-solid',
    className,
  )}
  {...rest}
>
  <slot />
</a>
