---
import { cn } from '@workspace/ui/lib/utils'

interface Props {
  href: string
  class?: string
  [attribute: string]: unknown
}

const { href, class: className, ...rest } = Astro.props
---

<a
  href={href}
  class={cn(
    'inline-flex min-h-11 min-w-11 items-center rounded-md text-foreground underline decoration-border underline-offset-4 outline-hidden hover:decoration-primary focus-visible:ring-3 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background',
    className,
  )}
  {...rest}
>
  <slot />
</a>
