---
import { getClosingCopy } from '../i18n/landing'
import type { Locale } from '../i18n/locales'
import { REVIEWS, STORE_REVIEWS_URL } from '../i18n/proof'
import CardGrid from './CardGrid.astro'
import Eyebrow from './Eyebrow.astro'
import Panel from './Panel.astro'
import Section from './Section.astro'
import TextLink from './TextLink.astro'

interface Props {
  locale: Locale
}

const { proof } = getClosingCopy(Astro.props.locale)
---

<Section section="proof" heading={proof.heading}>
  <Eyebrow data-proof="numbers" class="mt-5 max-w-2xl">{proof.numbers}</Eyebrow>
  <p
    data-proof="rename-note"
    class="mt-5 max-w-2xl text-[1.0625rem] leading-[1.55] text-muted-foreground"
  >
    {proof.renameNote}
  </p>
  {
    proof.reviewsLead !== '' && (
      <p class="mt-3 max-w-2xl leading-[1.55] text-muted-foreground">
        {proof.reviewsLead}
      </p>
    )
  }
  <CardGrid>
    {
      REVIEWS.map((review) => (
        <Panel>
          <figure lang="en" class="flex h-full flex-col justify-between gap-6">
            <blockquote class="leading-[1.55]">
              &ldquo;{review.quote}&rdquo;
            </blockquote>
            <figcaption class="font-mono text-[0.8125rem] tracking-[0.12em] text-muted-foreground">
              {review.author}, {review.date}
            </figcaption>
          </figure>
        </Panel>
      ))
    }
  </CardGrid>
  <p class="mt-8">
    <TextLink href={STORE_REVIEWS_URL} data-reviews-link rel="noopener">
      {proof.link}
    </TextLink>
  </p>
</Section>
