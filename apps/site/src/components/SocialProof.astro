---
import { Card, CardContent, CardFooter } from '@workspace/ui/components/card'
import { getClosingCopy } from '../i18n/landing'
import type { Locale } from '../i18n/locales'
import { REVIEWS, STORE_REVIEWS_URL } from '../i18n/proof'
import CardGrid from './CardGrid.astro'
import Eyebrow from './Eyebrow.astro'
import Section from './Section.astro'
import TextLink from './TextLink.astro'

interface Props {
  locale: Locale
}

const { proof } = getClosingCopy(Astro.props.locale)
---

<Section section="proof" heading={proof.heading}>
  <Eyebrow data-proof="numbers" class="mt-5 max-w-2xl">
    {proof.numbers}
  </Eyebrow>
  <p
    data-proof="rename-note"
    class="mt-5 max-w-2xl text-lead text-muted-foreground"
  >
    {proof.renameNote}
  </p>
  {proof.reviewsLead !== '' && (
    <p class="mt-3 max-w-2xl leading-body text-muted-foreground">
      {proof.reviewsLead}
    </p>
  )}
  <CardGrid>
    {REVIEWS.map((review) => (
      <li class="flex">
        <Card lang="en" size="lg" className="w-full">
          <CardContent className="flex-1">
            <blockquote class="leading-body text-base">
              &ldquo;{review.quote}&rdquo;
            </blockquote>
          </CardContent>
          <CardFooter className="border-t-0 bg-transparent pt-0">
            <p class="font-mono text-eyebrow tracking-eyebrow text-muted-foreground">
              {review.author}, {review.date}
            </p>
          </CardFooter>
        </Card>
      </li>
    ))}
  </CardGrid>
  <p class="mt-8">
    <TextLink href={STORE_REVIEWS_URL} data-reviews-link>
      {proof.link}
    </TextLink>
  </p>
</Section>
