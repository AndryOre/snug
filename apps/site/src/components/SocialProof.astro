---
import { Card, CardContent } from '@workspace/ui/components/card'
import { getContent } from '../i18n/content'
import { getClosingCopy } from '../i18n/landing'
import type { Locale } from '../i18n/locales'
import { REVIEWS, STORE_REVIEWS_URL } from '../i18n/proof'
import Section from './Section.astro'
import TextLink from './TextLink.astro'

interface Props {
  locale: Locale
}

const { proof } = getClosingCopy(Astro.props.locale)
const { reviews } = getContent(Astro.props.locale).landing
---

<Section section="proof" heading={reviews.heading}>
  <p
    data-proof="rename-note"
    class="mt-5 max-w-2xl text-lead text-muted-foreground"
  >
    {reviews.note}
  </p>
  <div class="mt-10 scroll-reveal">
    {/* eslint-disable-next-line jsx-a11y/no-noninteractive-tabindex -- keyboard and touch users pause the marquee through :focus-within (WCAG 2.2.2) */}
    <div data-proof-viewport role="group" tabindex="0">
      <div data-proof-track>
        {[false, true].map((isClone) => (
          <ul data-proof-row aria-hidden={isClone ? 'true' : undefined}>
            {REVIEWS.map((review) => (
              <li data-proof-card>
                <Card lang="en" size="lg" className="h-full w-full">
                  <figure class="contents">
                    <CardContent className="flex-1">
                      <blockquote class="leading-body text-base">
                        &ldquo;{review.quote}&rdquo;
                      </blockquote>
                    </CardContent>
                    <figcaption class="px-(--card-spacing) font-mono text-eyebrow tracking-eyebrow text-muted-foreground">
                      {review.author}, {review.date}
                    </figcaption>
                  </figure>
                </Card>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </div>
  <p class="mt-8">
    <TextLink
      href={STORE_REVIEWS_URL}
      data-reviews-link
      data-umami-event="reviews-click"
    >
      {proof.link}
    </TextLink>
  </p>
</Section>
