---
import { Folder } from 'lucide-react'
import { getContent } from '../i18n/content'
import type { Locale } from '../i18n/locales'

interface Props {
  locale: Locale
}

const { folders: names } = getContent(Astro.props.locale).landing.hero
const folders = [names.research, names.jobSearch]
---

<ul class="flex flex-col gap-2">
  {folders.map((folder) => (
    <li class="flex min-w-0 items-center gap-2 text-sm break-words">
      <Folder
        className="size-4 shrink-0 text-primary-text"
        aria-hidden="true"
      />
      {folder}
    </li>
  ))}
</ul>
