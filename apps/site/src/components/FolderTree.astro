---
import { Folder } from 'lucide-react'
import { getLandingCopy } from '../i18n/landing'
import type { Locale } from '../i18n/locales'

interface Props {
  locale: Locale
}

const { journey } = getLandingCopy(Astro.props.locale).hero
const folders = [journey.folderResearch, journey.folderJobSearch]
---

<ul class="flex flex-col gap-2">
  {folders.map((folder) => (
    <li class="flex min-w-0 items-center gap-2 text-sm break-words">
      <Folder
        className="size-4 shrink-0 text-primary-text"
        aria-hidden="true"
      />
      {folder}
    </li>
  ))}
</ul>
