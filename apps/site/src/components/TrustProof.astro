---
import { getLandingCopy, TRUST_LINK_HREFS } from '../i18n/landing'
import type { Locale } from '../i18n/locales'
import CardGrid from './CardGrid.astro'
import InstallButton from './InstallButton.astro'
import NumberedCard from './NumberedCard.astro'
import Section from './Section.astro'
import TextLink from './TextLink.astro'

interface Props {
  locale: Locale
}

const { hero, trust } = getLandingCopy(Astro.props.locale)
const points = [
  { numeral: '01', ...trust.points.network },
  { numeral: '02', ...trust.points.account },
  { numeral: '03', ...trust.points.source },
]
const linkKeys = [
  'source',
  'scorecard',
  'bestPractices',
  'ci',
  'privacy',
] as const
---

<Section section="trust" heading={trust.heading} lead={trust.intro}>
  <CardGrid as="ol">
    {points.map((point) => <NumberedCard {...point} />)}
  </CardGrid>
  <p class="mt-8 max-w-2xl leading-body text-muted-foreground">
    {trust.access}
  </p>
  <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
    {
      linkKeys.map((key) => (
        <li>
          <TextLink href={TRUST_LINK_HREFS[key]}>{trust.links[key]}</TextLink>
        </li>
      ))
    }
  </ul>
  <div class="mt-10">
    <InstallButton placement="trust" label={hero.install} />
  </div>
</Section>
