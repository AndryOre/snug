---
import brave from '../assets/browsers/brave.svg'
import chrome from '../assets/browsers/chrome.svg'
import edge from '../assets/browsers/edge.svg'
import firefox from '../assets/browsers/firefox.svg'
import opera from '../assets/browsers/opera.svg'
import safari from '../assets/browsers/safari.svg'
import { countUpParts, getLandingCopy } from '../i18n/landing'
import type { Locale } from '../i18n/locales'
import Section from './Section.astro'

interface Props {
  locale: Locale
}

const { stats, marquee } = getLandingCopy(Astro.props.locale)
const statKeys = ['users', 'rating', 'formats', 'network'] as const
const groups = [
  {
    key: 'browsers',
    label: marquee.browsers,
    logos: [
      { name: 'Chrome', src: chrome.src },
      { name: 'Edge', src: edge.src },
      { name: 'Brave', src: brave.src },
      { name: 'Opera', src: opera.src },
    ],
  },
  {
    key: 'sources',
    label: marquee.sources,
    logos: [
      { name: 'Firefox', src: firefox.src },
      { name: 'Safari', src: safari.src },
    ],
  },
]
---

<Section section="stats" class="border-y">
  <dl class="grid grid-cols-2 md:grid-cols-4">
    {statKeys.map((key) => {
      const { target, format, separator } = countUpParts(stats[key].value)
      return (
        <div class="flex flex-col-reverse gap-2 border-r px-5 py-5.5 last:border-r-0 max-md:nth-[n+3]:border-t max-md:even:border-r-0">
          <dt class="font-mono text-xs tracking-eyebrow text-muted-foreground uppercase">
            {stats[key].label}
          </dt>
          <dd
            data-stat={format}
            style={{
              '--stat-target': target,
              '--stat-separator': `"${separator}"`,
            }}
            class="font-heading leading-none font-bold text-primary-text tabular-nums"
          >
            <span data-stat-text>{stats[key].value}</span>
          </dd>
        </div>
      )
    })}
  </dl>
</Section>

<section data-section="marquee" class="overflow-hidden">
  <div class="mx-auto max-w-site py-10">
    <div
      data-marquee-viewport
      role="group"
      // eslint-disable-next-line jsx-a11y/no-noninteractive-tabindex -- keyboard and touch users pause the marquee through :focus-within (WCAG 2.2.2)
      tabindex="0"
      aria-label={marquee.browsers}
      class="rounded-md focus-ring-solid"
    >
      <div data-marquee-track>
        {[false, true].map((isClone) => (
          <div data-marquee-row aria-hidden={isClone ? 'true' : undefined}>
            {groups.map((group) => (
              <div data-marquee-group>
                <p data-marquee-label>{group.label}</p>
                <ul data-marquee-logos>
                  {group.logos.map((logo) => (
                    <li data-marquee-logo>
                      <img src={logo.src} alt="" width="24" height="24" />
                      <span>{logo.name}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const MARQUEE_SPEED_PX_PER_SECOND = 40
  const track = document.querySelector<HTMLElement>('[data-marquee-track]')
  if (track) {
    const rowWidth = track.scrollWidth / 2
    track.style.setProperty(
      '--marquee-duration',
      `${(rowWidth / MARQUEE_SPEED_PX_PER_SECOND).toFixed(2)}s`,
    )
  }
</script>
