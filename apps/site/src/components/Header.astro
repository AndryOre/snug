---
import { getClosingCopy } from '../i18n/landing'
import { buttonVariants } from '@workspace/ui/components/button'

import {
  languageTag,
  LOCALE_NAMES,
  localePath,
  LOCALES,
  type Locale,
} from '../i18n/locales'
import HeaderMenus from './HeaderMenus'

interface Props {
  locale: Locale
  markCurrent?: boolean
  pageHref?: (locale: Locale) => string
  skipLink?: boolean
}

const {
  locale,
  markCurrent = true,
  pageHref = localePath,
  skipLink = true,
} = Astro.props
const { header } = getClosingCopy(locale)
const options = LOCALES.map((code) => ({
  code,
  href: pageHref(code),
  tag: languageTag(code),
  name: LOCALE_NAMES[code],
}))
---

<header data-section="header" class="relative z-10">
  {skipLink && (
    <a
      href="#main"
      class={buttonVariants({
        className:
          'sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-4 focus:z-50',
      })}
    >
      {header.skipLink}
    </a>
  )}
  <div class="mx-auto flex h-14 max-w-site items-center justify-between gap-2 px-4 md:px-14">
    <a
      href={localePath(locale)}
      aria-label={header.homeLabel}
      class="flex min-h-11 shrink-0 items-center gap-2 rounded-md outline-hidden focus-visible:ring-3 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 84 84"
        class="size-6"
        focusable="false"
      >
        <defs>
          <linearGradient id="header-tag" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" style="stop-color: #ffa230"></stop>
            <stop offset="1" style="stop-color: #ffd37a"></stop>
          </linearGradient>
        </defs>
        <path
          fill="url(#header-tag)"
          d="M20 8 L64 8 Q70 8 70 14 L70 68 Q70 78 61 72 L42 59 L23 72 Q14 78 14 68 L14 14 Q14 8 20 8 Z"
        ></path>
      </svg>
      <span translate="no" class="text-lg font-semibold tracking-tight">
        Snug
      </span>
    </a>
    <slot name="nav" />
    <slot name="search" />
    <HeaderMenus
      client:idle
      theme={header.theme}
      language={{
        current: locale,
        currentTag: languageTag(locale),
        currentName: LOCALE_NAMES[locale],
        label: header.languageLabel,
        separator: header.languageSeparator,
        options,
        markCurrent,
      }}
    />
  </div>
</header>
