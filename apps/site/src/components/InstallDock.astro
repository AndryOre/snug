---
import { getContent } from '../i18n/content'
import type { Locale } from '../i18n/locales'
import InstallButton from './InstallButton.astro'

interface Props {
  locale: Locale
}

const { dock } = getContent(Astro.props.locale).landing
---

<div data-dock>
  <InstallButton placement="dock" label={dock.install} />
</div>
