---
import { getClosingCopy } from '../i18n/landing'
import {
  languageTag,
  LOCALE_NAMES,
  localePath,
  LOCALES,
  type Locale,
} from '../i18n/locales'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { header } = getClosingCopy(locale)
---

<div class="min-w-0" data-language-switcher>
  <button
    type="button"
    popovertarget="language-menu"
    class="language-trigger flex min-h-11 max-w-full cursor-pointer items-center gap-2 rounded-md px-3 text-foreground outline-hidden hover:text-primary-text focus-visible:ring-3 focus-visible:ring-ring/50"
  >
    <span class="sr-only">
      {header.languageLabel}
      {header.languageSeparator}
    </span>
    <span lang={languageTag(locale)} class="min-w-0 truncate">
      {LOCALE_NAMES[locale]}
    </span>
    <span class="shrink-0 font-mono text-sm text-primary-text">
      {languageTag(locale)}
    </span>
  </button>
  <nav
    id="language-menu"
    popover="auto"
    aria-label={header.languageLabel}
    class="language-panel w-56 max-w-panel rounded-xl border border-border bg-card p-2 text-foreground"
  >
    <ul>
      {LOCALES.map((code) => (
        <li>
          <a
            href={localePath(code)}
            lang={languageTag(code)}
            hreflang={languageTag(code)}
            aria-current={code === locale ? 'page' : undefined}
            class="flex min-h-11 items-center rounded-md px-3 outline-hidden hover:bg-muted focus-visible:ring-3 focus-visible:ring-ring/50 aria-[current=page]:text-primary-text"
          >
            {LOCALE_NAMES[code]}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>
