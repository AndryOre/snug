---
import { getClosingCopy } from '../i18n/landing'
import {
  languageTag,
  LOCALE_NAMES,
  localePath,
  LOCALES,
  type Locale,
} from '../i18n/locales'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { header } = getClosingCopy(locale)
---

<details class="relative" data-language-switcher>
  <summary
    class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-md px-3 text-foreground outline-none marker:hidden hover:text-primary-text focus-visible:ring-3 focus-visible:ring-ring/50 [&::-webkit-details-marker]:hidden"
  >
    <span aria-hidden="true" class="font-mono text-primary-text">
      {languageTag(locale)}
    </span>
    <span lang={languageTag(locale)}>{LOCALE_NAMES[locale]}</span>
  </summary>
  <nav
    aria-label={header.languageLabel}
    class="absolute bottom-full left-0 z-10 mb-2 min-w-56 rounded-[14px] border border-border bg-card p-2"
  >
    <ul>
      {
        LOCALES.map((code) => (
          <li>
            <a
              href={localePath(code)}
              lang={languageTag(code)}
              hreflang={languageTag(code)}
              aria-current={code === locale ? 'page' : undefined}
              class="flex min-h-11 items-center rounded-md px-3 outline-none hover:bg-muted focus-visible:ring-3 focus-visible:ring-ring/50 aria-[current=page]:text-primary-text"
            >
              {LOCALE_NAMES[code]}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</details>
