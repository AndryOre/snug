---
import {
  Empty,
  EmptyContent,
  EmptyDescription,
  EmptyHeader,
} from '@workspace/ui/components/empty'

import { DOCS_UI } from '../i18n/docs-ui'
import { FOOTER_LINK_HREFS, getClosingCopy, resolveHref } from '../i18n/landing'
import { localePath, type Locale } from '../i18n/locales'
import Layout from '../layouts/Layout.astro'
import SectionHeading from './SectionHeading.astro'
import TextLink from './TextLink.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { footer, notFound } = getClosingCopy(locale)
const page = {
  meta: { title: `${notFound.title} | Snug`, description: notFound.body },
  path: () => '/404/',
  alternateLocales: [],
}
---

<Layout locale={locale} notFound page={page}>
  <main id="main" class="flex flex-1 px-4">
    <Empty>
      <EmptyHeader className="max-w-prose">
        <SectionHeading as="h1">{notFound.title}</SectionHeading>
        <EmptyDescription>{notFound.body}</EmptyDescription>
      </EmptyHeader>
      <EmptyContent>
        <TextLink href={localePath(locale)}>{notFound.backLink}</TextLink>
        <ul
          class="m-0 flex list-none flex-wrap justify-center gap-x-6 gap-y-2 p-0"
          data-not-found-links
        >
          <li>
            <TextLink href={resolveHref(FOOTER_LINK_HREFS.guide, locale)}>
              {DOCS_UI.guide}
            </TextLink>
          </li>
          <li>
            <TextLink href={resolveHref(FOOTER_LINK_HREFS.howTo, locale)}>
              {footer.howTo}
            </TextLink>
          </li>
        </ul>
      </EmptyContent>
    </Empty>
  </main>
</Layout>
