---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

import { getLandingCopy, SHOT_KEYS } from '../i18n/landing'
import type { Locale } from '../i18n/locales'
import Section from './Section.astro'

interface Props {
  locale: Locale
}

const SHOT_FILES = {
  export: '01-export',
  import: '02-import',
  autoExport: '03-auto-export',
  popup: '04-popup',
} as const

const SIZES =
  '(min-width: 1240px) 552px, (min-width: 768px) calc((100vw - 136px) / 2), calc(100vw - 32px)'

const THEMES = [
  { theme: 'light', directory: 'light/', visibility: 'block dark:hidden' },
  { theme: 'dark', directory: '', visibility: 'hidden dark:block' },
] as const

const screenshots = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/screenshots/**/*.png',
  { eager: true },
)

const { locale } = Astro.props
const copy = getLandingCopy(locale).interface
---

<Section section="interface" heading={copy.heading} class="defer-render-lg">
  <div class="mt-10 grid gap-6 md:grid-cols-2">
    {SHOT_KEYS.map((key) => (
      <figure class="m-0">
        {THEMES.map(({ theme, directory, visibility }) => (
          <Image
            src={
              screenshots[
                `../assets/screenshots/${locale}/${directory}${SHOT_FILES[key]}.png`
              ]!.default
            }
            alt={copy.alts[key]}
            widths={[640, 960, 1280]}
            sizes={SIZES}
            format="webp"
            data-shot-theme={theme}
            class={`h-auto w-full rounded-2xl border border-border ${visibility}`}
          />
        ))}
        <figcaption class="mt-3 text-sm leading-body text-muted-foreground">
          {copy.shots[key]}
        </figcaption>
      </figure>
    ))}
  </div>
</Section>
