---
import { cn } from '@workspace/ui/lib/utils'

import { getLandingCopy, TRUST_LINK_HREFS } from '../i18n/landing'
import type { Locale } from '../i18n/locales'
import HeroJourney from './HeroJourney.astro'
import InstallButton from './InstallButton.astro'
import Section from './Section.astro'
import TextLink from './TextLink.astro'

interface Props {
  locale: Locale
}

const { hero } = getLandingCopy(Astro.props.locale)
const { stages, description, chips } = hero
---

<Section section="hero" class="-mt-14 bg-hero-glow pt-14">
  <h1
    class={cn(
      'max-w-4xl font-heading text-display font-bold break-words phrase-break text-balance',
      Astro.props.locale === 'de' ? 'hyphens-manual' : 'hyphens-auto',
    )}
  >
    {hero.headline}
  </h1>
  <p class="mt-6 max-w-2xl text-lead text-muted-foreground">
    {hero.subheadline}
  </p>
  <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
    <InstallButton placement="hero" label={hero.cta} />
    <TextLink
      href={TRUST_LINK_HREFS.source}
      data-umami-event="outbound-click"
      data-umami-event-target="hero-source"
    >
      {hero.source}
    </TextLink>
  </div>
  <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm text-muted-foreground">
    {Object.values(chips).map((chip) => (
      <li>{chip}</li>
    ))}
  </ul>
  <figure
    class="mt-14 mb-0 max-w-5xl"
    aria-labelledby="journey-device"
    aria-describedby="journey-description"
  >
    <p id="journey-description" class="sr-only">
      {description}
    </p>
    <HeroJourney locale={Astro.props.locale} />
    <figcaption
      data-journey="network"
      class="mt-4 font-mono text-sm text-muted-foreground"
    >
      {stages.network}
    </figcaption>
  </figure>
</Section>
