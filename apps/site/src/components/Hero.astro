---
import { getLandingCopy, TRUST_LINK_HREFS } from '../i18n/landing'
import type { Locale } from '../i18n/locales'
import Eyebrow from './Eyebrow.astro'
import InstallButton from './InstallButton.astro'
import Section from './Section.astro'
import TextLink from './TextLink.astro'

interface Props {
  locale: Locale
}

const { hero } = getLandingCopy(Astro.props.locale)
---

<Section
  section="hero"
  class="bg-hero-glow"
>
  <Eyebrow class="mb-6">{hero.eyebrow}</Eyebrow>
  <h1
    class="max-w-4xl font-heading text-display font-bold break-words hyphens-auto text-balance"
  >
    <span class="block">{hero.headlineLead}</span>
    <span class="block text-primary-text">{hero.headlineAccent}</span>
  </h1>
  <p
    class="mt-6 max-w-2xl text-lead text-muted-foreground"
  >
    {hero.subheadline}
  </p>
  <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
    <InstallButton placement="hero" label={hero.install} />
    <TextLink href={TRUST_LINK_HREFS.source}>{hero.source}</TextLink>
  </div>
  <p class="mt-4 text-sm text-muted-foreground">{hero.note}</p>
</Section>
