---
import { cn } from '@workspace/ui/lib/utils'

interface Props {
  as?: 'ol' | 'ul'
  columns?: 'auto' | 'three'
  class?: string
}

const { as: Tag = 'ul', columns = 'auto', class: className } = Astro.props
---

<Tag
  class={cn(
    'mt-10 grid gap-4',
    columns === 'three' ? 'grid-cols-1 lg:grid-cols-3' : 'grid-cols-auto-cards',
    className,
  )}
>
  <slot />
</Tag>
