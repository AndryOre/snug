---
import { cn } from '@workspace/ui/lib/utils'

interface Props {
  as?: 'ol' | 'ul'
  class?: string
}

const { as: Tag = 'ul', class: className } = Astro.props
---

<Tag
  class={cn(
    'mt-10 grid grid-cols-[repeat(auto-fit,minmax(min(260px,100%),1fr))] gap-4',
    className,
  )}
>
  <slot />
</Tag>
