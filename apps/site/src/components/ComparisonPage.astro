---
import { Card, CardHeader, CardTitle } from '@workspace/ui/components/card'

import { COMPETITORS } from '../content/competitors'
import { comparisonSubjects } from '../i18n/comparison-table'
import {
  alternativesPath,
  type ComparisonSlug,
  getComparisonContent,
  interpolateComparison,
} from '../i18n/comparisons'
import { type Locale, localePath } from '../i18n/locales'
import Layout from '../layouts/Layout.astro'
import { comparisonPageDescriptor } from '../seo/comparison-descriptor'
import ComparisonBreadcrumb from './ComparisonBreadcrumb.astro'
import ComparisonTable from './ComparisonTable.astro'
import Eyebrow from './Eyebrow.astro'
import FinalCta from './FinalCta.astro'
import SectionHeading from './SectionHeading.astro'
import TextLink from './TextLink.astro'

interface Props {
  locale: Locale
  slug: ComparisonSlug
}

const { locale, slug } = Astro.props
const { shared, pages } = getComparisonContent(locale)
const copy = pages[slug]
const facts = COMPETITORS[slug]
const page = comparisonPageDescriptor(locale, slug)
const values = {
  users: facts.userCount,
  rating: facts.ratingValue,
  languages:
    facts.languageCount === 'not-listed' ? undefined : facts.languageCount,
  historyMonths: facts.historyLimitMonths,
  date: facts.verifiedOn,
  name: facts.shortName,
}
const fill = (template: string) =>
  interpolateComparison(template, locale, values)
const subjects = comparisonSubjects().filter(
  (subject) => subject.isSnug || subject.slug === slug,
)
const crumbs = [
  { name: shared.breadcrumb.home, href: localePath(locale) },
  {
    name: shared.breadcrumb.alternatives,
    href: alternativesPath(locale),
  },
  { name: facts.name },
]
const headingClass = 'font-heading text-2xl font-bold md:text-3xl'
const listClass = 'mt-4 list-disc space-y-2 pl-6 leading-prose'
---

<Layout locale={locale} page={page}>
  <main id="main">
    <div class="mx-auto max-w-site px-4 py-14 md:px-14 md:py-24">
      <ComparisonBreadcrumb label={shared.breadcrumb.label} crumbs={crumbs} />
      <header class="mt-8">
        <Eyebrow>{copy.eyebrow}</Eyebrow>
        <SectionHeading as="h1" class="mt-3 hyphens-manual wrap-anywhere">
          {copy.title}
        </SectionHeading>
      </header>
      <section
        data-section="in-short"
        aria-labelledby="in-short-heading"
        class="mt-10 max-w-3xl rounded-xl bg-card"
      >
        <div class="rounded-xl border border-primary/50 bg-primary/8 p-4 md:p-5">
          <Eyebrow as="p" id="in-short-heading">
            {shared.tldr}
          </Eyebrow>
          <p class="mt-1 text-base leading-prose">{fill(copy.tldr)}</p>
        </div>
      </section>
      <section
        data-section="at-a-glance"
        aria-labelledby="at-a-glance-heading"
        class="mt-12"
      >
        <h2 id="at-a-glance-heading" class={headingClass}>
          {shared.atAGlance}
        </h2>
        <div class="mt-6">
          <ComparisonTable
            locale={locale}
            subjects={subjects}
            variant="pair"
            caption={fill(shared.asOf)}
            id="comparison-table"
          />
        </div>
      </section>
      <section
        data-section="why-look"
        aria-labelledby="why-look-heading"
        class="mt-12 max-w-3xl"
      >
        <h2 id="why-look-heading" class={headingClass}>
          {copy.whyLook.title}
        </h2>
        <p class="mt-4 leading-prose">{fill(copy.whyLook.body)}</p>
      </section>
      <section
        data-section="picks"
        aria-labelledby="pick-snug-heading pick-other-heading"
        class="mt-12"
      >
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          <Card size="lg" className="w-full">
            <CardHeader>
              <CardTitle>
                <h2
                  id="pick-snug-heading"
                  class="text-xl leading-tight break-words"
                >
                  {shared.pickSnug}
                </h2>
              </CardTitle>
              <ul class={`${listClass} text-muted-foreground`}>
                {copy.pickSnug.map((item) => (
                  <li>{fill(item)}</li>
                ))}
              </ul>
            </CardHeader>
          </Card>
          <Card size="lg" className="w-full">
            <CardHeader>
              <CardTitle>
                <h2
                  id="pick-other-heading"
                  class="text-xl leading-tight break-words"
                >
                  {fill(shared.pickOther)}
                </h2>
              </CardTitle>
              <ul class={`${listClass} text-muted-foreground`}>
                {copy.pickOther.map((item) => (
                  <li>{fill(item)}</li>
                ))}
              </ul>
            </CardHeader>
          </Card>
        </div>
      </section>
      <section
        data-section="switching"
        aria-labelledby="switching-heading"
        class="mt-12 max-w-3xl"
      >
        <h2 id="switching-heading" class={headingClass}>
          {shared.switching}
        </h2>
        <ol class="mt-4 list-decimal space-y-2 pl-6 leading-prose">
          {copy.switching.steps.map((step) => (
            <li>{fill(step)}</li>
          ))}
        </ol>
      </section>
      <p
        data-section="as-of"
        class="mt-12 max-w-3xl border-t border-border pt-4 text-sm text-muted-foreground"
      >
        {fill(shared.checkedNote)}{' '}
        <TextLink
          href={facts.storeUrl}
          rel="noopener nofollow"
          class="min-h-0 text-foreground wrap-anywhere"
          lang="en"
        >
          {facts.name}
        </TextLink>
      </p>
    </div>
    <FinalCta
      locale={locale}
      heading={shared.ctaTitle}
      line={shared.ctaBody}
      button={shared.install}
    />
  </main>
</Layout>
