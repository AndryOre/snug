---
import { getClosingCopy } from '../i18n/landing'
import type { Locale } from '../i18n/locales'
import FaqAccordion from './FaqAccordion'
import Section from './Section.astro'

interface Props {
  locale: Locale
}

const { faq } = getClosingCopy(Astro.props.locale)
const entries = Object.values(faq.items)
---

<Section section="faq" heading={faq.heading}>
  <FaqAccordion client:visible entries={entries} />
</Section>
