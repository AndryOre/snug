---
import { Badge } from '@workspace/ui/components/badge'
import {
  Card,
  CardContent,
  CardHeader,
  CardTitle,
} from '@workspace/ui/components/card'
import { ArrowRight } from 'lucide-react'

import braveLogo from '../assets/browsers/brave.svg'
import chromeLogo from '../assets/browsers/chrome.svg'
import edgeLogo from '../assets/browsers/edge.svg'
import operaLogo from '../assets/browsers/opera.svg'
import { getContent } from '../i18n/content'
import { EXPORT_FORMATS } from '../i18n/landing'
import type { Locale } from '../i18n/locales'
import FolderTree from './FolderTree.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { stages } = getContent(locale).landing.hero
const formats = EXPORT_FORMATS

const sourceBrowsers = [
  { name: 'Chrome', logo: chromeLogo },
  { name: 'Edge', logo: edgeLogo },
  { name: 'Brave', logo: braveLogo },
]
const targetBrowsers = [
  { name: 'Edge', logo: edgeLogo },
  { name: 'Brave', logo: braveLogo },
  { name: 'Opera', logo: operaLogo },
]
const ribbonPath =
  'M20 8 L64 8 Q70 8 70 14 L70 68 Q70 78 61 72 L42 59 L23 72 Q14 78 14 68 L14 14 Q14 8 20 8 Z'
---

<div class="relative journey-boundary p-4 pt-8 md:p-6 md:pt-9">
  <p
    id="journey-device"
    class="absolute top-0 left-5 -translate-y-1/2 bg-background px-3 font-mono text-xs tracking-eyebrow text-primary-text uppercase"
  >
    {stages.device}
  </p>
  <div
    class="hero-stage flex flex-col items-stretch gap-3 md:flex-row md:gap-4"
    aria-hidden="true"
  >
    <Card size="sm" className="min-w-0 flex-1">
      <CardHeader>
        <CardTitle className="break-words">{stages.browser}</CardTitle>
      </CardHeader>
      <CardContent>
        <div class="hero-logos mb-3">
          {sourceBrowsers.map(({ name, logo }) => (
            <span
              class="flex items-center gap-2 text-sm font-medium"
              translate="no"
            >
              <img src={logo.src} width="28" height="28" alt="" />
              {name}
            </span>
          ))}
        </div>
        <div class="hero-tree-source">
          <FolderTree locale={locale} />
        </div>
      </CardContent>
    </Card>
    <ArrowRight
      className="hero-arrow hero-arrow-in size-5 shrink-0 rotate-90 self-center text-primary md:rotate-0"
      aria-hidden="true"
    />
    <div class="hero-track relative h-32 shrink-0 md:h-24 md:w-40 lg:w-48">
      <p
        translate="no"
        class="hero-file absolute flex flex-col items-center gap-1 font-mono text-xs whitespace-nowrap text-foreground"
      >
        <svg
          viewBox="0 0 84 84"
          width="56"
          height="56"
          aria-hidden="true"
          focusable="false"
        >
          <defs>
            <linearGradient id="journey-ribbon" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#FFA230"></stop>
              <stop offset="1" stop-color="#FFD37A"></stop>
            </linearGradient>
          </defs>
          <path fill="url(#journey-ribbon)" d={ribbonPath}></path>
        </svg>
        bookmarks.html
      </p>
    </div>
    <ArrowRight
      className="hero-arrow hero-arrow-out size-5 shrink-0 rotate-90 self-center text-primary md:rotate-0"
      aria-hidden="true"
    />
    <Card size="sm" className="min-w-0 flex-1 ring-primary/50">
      <CardHeader>
        <CardTitle className="break-words">{stages.target}</CardTitle>
      </CardHeader>
      <CardContent>
        <div class="hero-logos mb-3">
          {targetBrowsers.map(({ name, logo }) => (
            <span
              class="flex items-center gap-2 text-sm font-medium"
              translate="no"
            >
              <img src={logo.src} width="28" height="28" alt="" />
              {name}
            </span>
          ))}
        </div>
        <div class="hero-tree-target">
          <FolderTree locale={locale} />
        </div>
      </CardContent>
    </Card>
  </div>
  <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2">
    <p class="font-mono text-xs text-muted-foreground">{stages.file}</p>
    <ul class="flex flex-wrap gap-1.5" translate="no">
      {formats.map((format) => (
        <li>
          <Badge variant="outline" className="font-mono">
            {format}
          </Badge>
        </li>
      ))}
    </ul>
  </div>
</div>
