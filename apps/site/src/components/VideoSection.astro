---
import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'

import { getLandingCopy, PROMO_VIDEO_IDS } from '../i18n/landing'
import type { Locale } from '../i18n/locales'
import Section from './Section.astro'
import VideoFacade from './VideoFacade'

interface Props {
  locale: Locale
}

const posters = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/video-posters/*.png',
  { eager: true },
)

const { locale } = Astro.props
const copy = getLandingCopy(locale).video
const poster = posters[`../assets/video-posters/${locale}.png`]!.default
const POSTER_WIDTHS = [640, 960, 1280] as const
const POSTER_SIZES =
  '(min-width: 1024px) 894px, (min-width: 768px) calc(100vw - 114px), calc(100vw - 34px)'
const posterImages = await Promise.all(
  POSTER_WIDTHS.map((width) =>
    getImage({ src: poster, width, format: 'webp' }),
  ),
)
const posterImage = posterImages.at(-1)!
const posterSourceSet = posterImages
  .map((image, index) => `${image.src} ${POSTER_WIDTHS[index]}w`)
  .join(', ')
---

<Section
  section="video"
  heading={copy.heading}
  lead={copy.caption}
  class="defer-render-sm"
>
  <div class="mt-10 max-w-4xl">
    <VideoFacade
      client:visible
      videoId={PROMO_VIDEO_IDS[locale]}
      title={copy.heading}
      playLabel={copy.play}
      labelSeparator={copy.labelSeparator}
      posterSrc={posterImage.src}
      posterSrcSet={posterSourceSet}
      posterSizes={POSTER_SIZES}
      posterWidth={poster.width}
      posterHeight={poster.height}
    />
    <p class="mt-3 text-sm leading-body text-muted-foreground">{copy.note}</p>
  </div>
</Section>
