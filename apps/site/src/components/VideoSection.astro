---
import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'

import { getLandingCopy, PROMO_VIDEO_IDS } from '../i18n/landing'
import type { Locale } from '../i18n/locales'
import Section from './Section.astro'
import VideoFacade from './VideoFacade'

interface Props {
  locale: Locale
}

const posters = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/video-posters/*.png',
  { eager: true },
)

const { locale } = Astro.props
const copy = getLandingCopy(locale).video
const poster = posters[`../assets/video-posters/${locale}.png`]!.default
const posterImage = await getImage({ src: poster, width: 1280, format: 'webp' })
---

<Section
  section="video"
  heading={copy.heading}
  lead={copy.caption}
  class="[contain-intrinsic-size:auto_900px] [content-visibility:auto]"
>
  <div class="mt-10 max-w-4xl">
    <VideoFacade
      client:idle
      videoId={PROMO_VIDEO_IDS[locale]}
      title={copy.heading}
      playLabel={copy.play}
      posterSrc={posterImage.src}
      posterWidth={poster.width}
      posterHeight={poster.height}
    />
    <p class="mt-3 text-sm leading-[1.55] text-muted-foreground">
      {copy.note}
    </p>
  </div>
</Section>
