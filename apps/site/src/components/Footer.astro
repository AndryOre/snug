---
import {
  FOOTER_LINK_HREFS,
  getClosingCopy,
  installHref,
  resolveHref,
} from '../i18n/landing'
import { Separator } from '@workspace/ui/components/separator'
import { DOCS_UI } from '../i18n/docs-ui'

import {
  languageTag,
  LOCALE_NAMES,
  localePath,
  LOCALES,
  type Locale,
} from '../i18n/locales'
import TextLink from './TextLink.astro'

interface Props {
  locale: Locale
  markCurrent?: boolean
  pageHref?: (locale: Locale) => string
}

const { locale, markCurrent = true, pageHref = localePath } = Astro.props
const { footer, header } = getClosingCopy(locale)
const links = [
  { key: 'source', href: FOOTER_LINK_HREFS.source, label: footer.source },
  {
    key: 'privacy',
    href: resolveHref(FOOTER_LINK_HREFS.privacy, locale),
    label: footer.privacy,
  },
  {
    key: 'guide',
    href: resolveHref(FOOTER_LINK_HREFS.guide, locale),
    label: DOCS_UI.guide,
  },
  {
    key: 'changelog',
    href: resolveHref(FOOTER_LINK_HREFS.changelog, locale),
    label: DOCS_UI.whatsNew,
  },
  { key: 'listing', href: installHref('footer'), label: footer.listing },
]
const noteParts = footer.note.split('Snug')
---

<footer data-section="footer" class="border-t border-border">
  <div class="mx-auto flex max-w-site flex-col gap-6 px-4 py-10 md:px-14">
    <nav aria-label={footer.navLabel}>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {links.map((link) => (
          <li>
            <TextLink
              href={link.href}
              data-footer-link={link.key}
              data-umami-event="outbound-click"
              data-umami-event-target={`footer-${link.key}`}
            >
              {link.label}
            </TextLink>
          </li>
        ))}
      </ul>
    </nav>
    <Separator />
    <nav aria-label={header.languageLabel} data-footer-languages>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {LOCALES.map((code) => (
          <li>
            <TextLink
              href={pageHref(code)}
              lang={languageTag(code)}
              hreflang={languageTag(code)}
              aria-current={markCurrent && code === locale ? 'page' : undefined}
              class="font-system aria-[current=page]:text-primary-text"
            >
              {LOCALE_NAMES[code]}
            </TextLink>
          </li>
        ))}
      </ul>
    </nav>
    <p class="text-sm text-muted-foreground">
      {noteParts.map((part, index) => (
        <>
          {index > 0 && <span translate="no">Snug</span>}
          {part}
        </>
      ))}
    </p>
  </div>
</footer>
