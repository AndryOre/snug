---
import '@workspace/ui/globals.css'
import { cn } from '@workspace/ui/lib/utils'

import spaceGroteskLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url'

import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { getPageMeta } from '../i18n/content'
import {
  hreflangAlternates,
  LOCALE_CONFIG,
  languageTag,
  localePath,
  ogImagePath,
  SITE_ORIGIN,
  type Locale,
} from '../i18n/locales'
import { OG_IMAGE, ogLocale, ogLocaleAlternates } from '../seo/open-graph'
import { buildSoftwareAppJsonLd } from '../seo/structured-data'

interface Props {
  locale: Locale
  notFound?: boolean
  standalone?: { title: string; description: string; path: string }
}

const { locale, notFound = false, standalone } = Astro.props
const meta = standalone ?? getPageMeta(locale)
const alternates = standalone ? [] : hreflangAlternates()
const canonical = `${SITE_ORIGIN}${standalone?.path ?? localePath(locale)}`
const ogImage = `${SITE_ORIGIN}${ogImagePath(locale)}`
const jsonLd = standalone
  ? null
  : JSON.stringify(buildSoftwareAppJsonLd(locale, meta.description)).replaceAll(
      '<',
      String.raw`\u003c`,
    )
---

<html lang={languageTag(locale)} dir={LOCALE_CONFIG[locale].dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#fbf7f0"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#17120a"
      media="(prefers-color-scheme: dark)"
    />
    <script is:inline>
      {
        const root = document.documentElement
        let theme = 'system'
        try {
          const stored = localStorage.getItem('snug:theme')
          if (stored === 'light' || stored === 'dark') theme = stored
        } catch {
          theme = 'system'
        }
        const dark =
          theme === 'dark' ||
          (theme === 'system' &&
            matchMedia('(prefers-color-scheme: dark)').matches)
        root.classList.toggle('dark', dark)
        root.classList.add('js')
      }
    </script>
    {LOCALE_CONFIG[locale].preloadLatinFont && (
      <link
        rel="preload"
        as="font"
        type="font/woff2"
        href={spaceGroteskLatin}
        crossorigin
      />
    )}
    {notFound ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <meta name="description" content={meta.description} />
        <link rel="canonical" href={canonical} />
        {alternates.map(({ hreflang, href }) => (
          <link rel="alternate" hreflang={hreflang} href={href} />
        ))}
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Snug" />
        <meta property="og:title" content={meta.title} />
        <meta property="og:description" content={meta.description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:locale" content={ogLocale(locale)} />
        {!standalone &&
          ogLocaleAlternates(locale).map((code) => (
            <meta property="og:locale:alternate" content={code} />
          ))}
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content={String(OG_IMAGE.width)} />
        <meta property="og:image:height" content={String(OG_IMAGE.height)} />
        <meta property="og:image:type" content={OG_IMAGE.type} />
        <meta property="og:image:alt" content={meta.description} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={meta.title} />
        <meta name="twitter:description" content={meta.description} />
        <meta name="twitter:image" content={ogImage} />
        {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
      </>
    )}
  </head>
  <body
    class={cn(
      'bg-background font-sans text-foreground',
      notFound && 'flex min-h-dvh flex-col',
    )}
  >
    <Header locale={locale} markCurrent={!standalone} />
    <slot />
    <Footer locale={locale} markCurrent={!standalone} />
  </body>
</html>
