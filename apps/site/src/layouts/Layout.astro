---
import '../styles/site.css'
import { cn } from '@workspace/ui/lib/utils'

import geistCyrillic from '@fontsource-variable/geist/files/geist-cyrillic-wght-normal.woff2?url'
import spaceGroteskLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url'

import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { getContent, getPageMeta } from '../i18n/content'
import {
  hreflangAlternates,
  LOCALE_CONFIG,
  languageTag,
  localePath,
  ogImagePath,
  SITE_ORIGIN,
  type FontPreload,
  type Locale,
} from '../i18n/locales'
import {
  ENGLISH_PRIVACY_PATH,
  PRIVACY_PAGE_LOCALES,
  privacyPath,
} from '../i18n/privacy'
import { OG_IMAGE, ogLocale, ogLocaleAlternates } from '../seo/open-graph'
import { PROMO_VIDEO_IDS } from '../i18n/landing'
import { buildStructuredData } from '../seo/structured-data'
import { THEME_INIT_SCRIPT } from '../scripts/theme-init'
import { UMAMI_DOMAINS, UMAMI_SCRIPT_URL, UMAMI_WEBSITE_ID } from '../seo/umami'

const FONT_PRELOAD_URLS: Record<FontPreload, string> = {
  'space-grotesk-latin': spaceGroteskLatin,
  'geist-cyrillic': geistCyrillic,
}

interface Props {
  locale: Locale
  notFound?: boolean
  privacy?: boolean
  standalone?: { title: string; description: string; path: string }
}

const { locale, notFound = false, privacy = false, standalone } = Astro.props
const content = getContent(locale)
const meta =
  standalone ?? (privacy ? content.privacy.meta : getPageMeta(locale))
const alternates = standalone
  ? []
  : privacy
    ? hreflangAlternates(ENGLISH_PRIVACY_PATH, PRIVACY_PAGE_LOCALES)
    : hreflangAlternates()
const pagePath =
  standalone?.path ?? (privacy ? privacyPath(locale) : localePath(locale))
const canonical = `${SITE_ORIGIN}${pagePath}`
const ogAlternates = standalone
  ? []
  : ogLocaleAlternates(locale, privacy ? PRIVACY_PAGE_LOCALES : undefined)
const ogImage = `${SITE_ORIGIN}${ogImagePath(locale)}`
const ogImageAlt = content.seo.ogImageAlt
const featureTitles = Object.values(content.features.items).map(
  (item) => item.title,
)
const jsonLd =
  standalone || privacy
    ? null
    : JSON.stringify(
        buildStructuredData(locale, meta.description, featureTitles, {
          title: meta.title,
          videoId: PROMO_VIDEO_IDS[locale],
          videoDescription: content.video.caption,
        }),
      ).replaceAll('<', String.raw`\u003c`)
---

<html lang={languageTag(locale)} dir={LOCALE_CONFIG[locale].dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#fbf7f0"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#17120a"
      media="(prefers-color-scheme: dark)"
    />
    <script is:inline set:html={THEME_INIT_SCRIPT} />
    <script
      is:inline
      defer
      src={UMAMI_SCRIPT_URL}
      data-website-id={UMAMI_WEBSITE_ID}
      data-do-not-track="true"
      data-domains={UMAMI_DOMAINS}
    ></script>
    {LOCALE_CONFIG[locale].preloadFonts.map((font) => (
      <link
        rel="preload"
        as="font"
        type="font/woff2"
        href={FONT_PRELOAD_URLS[font]}
        crossorigin
      />
    ))}
    {notFound ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <meta name="description" content={meta.description} />
        <link rel="canonical" href={canonical} />
        <link rel="describedby" href="/llms.txt" />
        {alternates.map(({ hreflang, href }) => (
          <link rel="alternate" hreflang={hreflang} href={href} />
        ))}
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Snug" />
        <meta property="og:title" content={meta.title} />
        <meta property="og:description" content={meta.description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:locale" content={ogLocale(locale)} />
        {ogAlternates.map((code) => (
          <meta property="og:locale:alternate" content={code} />
        ))}
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content={String(OG_IMAGE.width)} />
        <meta property="og:image:height" content={String(OG_IMAGE.height)} />
        <meta property="og:image:type" content={OG_IMAGE.type} />
        <meta property="og:image:alt" content={ogImageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={meta.title} />
        <meta name="twitter:description" content={meta.description} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:image:alt" content={ogImageAlt} />
        {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
      </>
    )}
  </head>
  <body
    class={cn(
      'bg-background font-sans text-foreground',
      notFound && 'flex min-h-dvh flex-col',
    )}
  >
    <Header
      locale={locale}
      markCurrent={!standalone}
      pageHref={privacy ? privacyPath : undefined}
    />
    <slot />
    <Footer
      locale={locale}
      markCurrent={!standalone}
      pageHref={privacy ? privacyPath : undefined}
    />
  </body>
</html>
