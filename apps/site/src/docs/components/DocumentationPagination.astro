---
import { cn } from '@workspace/ui/lib/utils'

const { dir, pagination } = Astro.locals.starlightRoute
const { prev, next } = pagination
const cardClass =
  'flex flex-col gap-1 rounded-lg border border-card-border bg-card p-4 text-card-foreground hover:border-primary focus-ring-solid'
---

{(prev || next) && (
  <nav class="grid gap-4 sm:grid-cols-2 print:hidden" dir={dir}>
    {prev && (
      <a href={prev.href} rel="prev" class={cardClass}>
        <span class="text-sm text-muted-foreground">
          {Astro.locals.t('page.previousLink')}
        </span>
        <span class="font-medium">{prev.label}</span>
      </a>
    )}
    {next && (
      <a
        href={next.href}
        rel="next"
        class={cn(cardClass, 'sm:col-start-2 sm:text-end')}
      >
        <span class="text-sm text-muted-foreground">
          {Astro.locals.t('page.nextLink')}
        </span>
        <span class="font-medium">{next.label}</span>
      </a>
    )}
  </nav>
)}
