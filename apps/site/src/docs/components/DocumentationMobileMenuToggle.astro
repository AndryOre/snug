---
import { DOCS_UI } from '../../i18n/docs-ui'
---

<button
  type="button"
  popovertarget="starlight__sidebar"
  aria-controls="starlight__sidebar"
  data-docs-menu-toggle
  class="print:hidden"
>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    class="size-4.5 shrink-0"
    focusable="false"
  >
    <path d="M4 6h16M4 12h16M4 18h16"></path>
  </svg>
  <span>{DOCS_UI.guide}</span>
</button>

<script>
  const sidebar = document.getElementById('starlight__sidebar')
  const toggle = document.querySelector<HTMLElement>('[data-docs-menu-toggle]')
  const outsideDrawer = () =>
    document.querySelectorAll('.header, .main-frame, .sl-skip-link')

  /**
   * Keeps the page out of the tab order while the drawer is open, moves focus
   * into it, and makes everything interactive again before the popover API
   * returns focus to the Guide button on close.
   */
  sidebar?.addEventListener('beforetoggle', (event) => {
    const opening = (event as ToggleEvent).newState === 'open'
    for (const element of outsideDrawer()) {
      element.toggleAttribute('inert', opening)
    }
    if (!opening) toggle?.removeAttribute('inert')
  })

  sidebar?.addEventListener('toggle', (event) => {
    if ((event as ToggleEvent).newState !== 'open') return
    sidebar.querySelector<HTMLElement>('a[href]')?.focus()
    toggle?.setAttribute('inert', '')
  })
</script>
