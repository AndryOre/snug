---
import TextLink from '../../components/TextLink.astro'
import { DOCS_UI } from '../../i18n/docs-ui'
import { externalLinkAttributes } from '../../site-links'

interface Props {
  href: string
}

const { href } = Astro.props
---

<TextLink
  href={href}
  class="self-start text-sm print:hidden"
  {...externalLinkAttributes()}
>
  {DOCS_UI.editPage}
  <span class="sr-only"> ({DOCS_UI.opensInNewTab})</span>
</TextLink>
