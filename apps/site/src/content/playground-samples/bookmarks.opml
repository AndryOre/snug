<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>Bookmarks</title>
  </head>
  <body>
    <outline text="Bookmarks bar" title="Bookmarks bar">
      <outline text="Reading list" title="Reading list">
        <outline type="link" text="Astro docs" title="Astro docs" url="https://docs.astro.build"/>
        <outline type="link" text="MDN Web Docs" title="MDN Web Docs" url="https://developer.mozilla.org"/>
      </outline>
      <outline type="link" text="Snug" title="Snug" url="https://snug.andryore.dev"/>
    </outline>
    <outline text="Other bookmarks" title="Other bookmarks"/>
  </body>
</opml>
