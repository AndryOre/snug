---
import { Content as PrivacyPolicy } from '../../../../PRIVACY_POLICY.md'
import standaloneContent from '../content/standalone/en.json'
import { Separator } from '@workspace/ui/components/separator'
import TextLink from '../components/TextLink.astro'
import Layout from '../layouts/Layout.astro'

const { privacy } = standaloneContent
const standalone = { ...privacy.meta, path: '/privacy/' }
---

<Layout locale="en" standalone={standalone}>
  <main id="main">
    <div class="mx-auto max-w-site px-4 py-14 md:px-14 md:py-24">
      <TextLink
        href="/"
        class="py-2 font-mono text-eyebrow tracking-eyebrow text-primary-text uppercase"
      >
        {privacy.homeLink}
      </TextLink>
      <p class="mt-6 max-w-2xl text-sm text-muted-foreground">
        {privacy.englishOnly}
      </p>
      <article data-section="policy" class="prose-policy mt-8 max-w-2xl">
        <PrivacyPolicy />
      </article>
      <Separator className="mt-14 max-w-2xl" />
      <section
        data-section="website-statement"
        aria-labelledby="website-heading"
        class="mt-10 max-w-2xl"
      >
        <h2 id="website-heading" class="font-heading text-2xl font-medium">
          {privacy.website.heading}
        </h2>
        <p class="mt-4 leading-prose">{privacy.website.body}</p>
        <p class="mt-4 leading-prose">{privacy.theme}</p>
      </section>
    </div>
  </main>
</Layout>
