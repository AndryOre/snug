---
import { Content as PrivacyPolicy } from '../../../../PRIVACY_POLICY.md'
import Layout from '../layouts/Layout.astro'

const standalone = {
  title: 'Privacy Policy | Snug',
  description:
    'How Snug handles your data: the extension sends nothing anywhere, and this website runs no analytics scripts.',
  path: '/privacy/',
}
---

<Layout locale="en" standalone={standalone}>
  <main>
    <div class="mx-auto max-w-[1240px] px-4 py-14 md:px-14 md:py-24">
      <a
        href="/"
        class="rounded-md py-2 font-mono text-[0.8125rem] tracking-[0.12em] text-primary-text uppercase underline decoration-border underline-offset-4 outline-none hover:decoration-primary focus-visible:ring-3 focus-visible:ring-ring/50"
      >
        Snug
      </a>
      <p class="mt-6 max-w-2xl text-sm text-muted-foreground">
        This page is available in English only. The other languages link here.
      </p>
      <article
        data-section="policy"
        class="mt-8 max-w-2xl leading-[1.65] [&_a]:underline [&_a]:decoration-border [&_a]:underline-offset-4 [&_a:hover]:decoration-primary [&_code]:font-mono [&_code]:text-[0.9em] [&_h1]:font-heading [&_h1]:text-[clamp(2.5rem,6vw,4rem)] [&_h1]:leading-[1.05] [&_h1]:font-bold [&_h1]:tracking-[-0.025em] [&_h1]:text-balance [&_h2]:mt-12 [&_h2]:font-heading [&_h2]:text-[1.5rem] [&_h2]:font-medium [&_h3]:mt-8 [&_h3]:font-heading [&_h3]:text-[1.125rem] [&_h3]:font-medium [&_li]:mt-2 [&_p]:mt-4 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6"
      >
        <PrivacyPolicy />
      </article>
      <section
        data-section="website-statement"
        aria-labelledby="website-heading"
        class="mt-14 max-w-2xl border-t border-border pt-10"
      >
        <h2 id="website-heading" class="font-heading text-[1.5rem] font-medium">
          This website
        </h2>
        <p class="mt-4 leading-[1.65]">
          This website runs no analytics scripts and loads nothing from third
          parties. Visits are counted only from the web server's access log,
          where IP addresses are masked, and the log is read offline.
        </p>
      </section>
    </div>
  </main>
</Layout>
