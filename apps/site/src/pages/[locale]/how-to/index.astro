---
import HowToIndexPage from '../../../components/HowToIndexPage.astro'
import { HOW_TO_INDEX_LOCALES } from '../../../i18n/how-to'
import { DEFAULT_LOCALE, languageTag, LOCALES } from '../../../i18n/locales'

export function getStaticPaths() {
  return HOW_TO_INDEX_LOCALES.filter((locale) => locale !== DEFAULT_LOCALE).map(
    (locale) => ({
      params: { locale: languageTag(locale).toLowerCase() },
    }),
  )
}

const segment = Astro.params.locale
const locale = LOCALES.find(
  (candidate) => languageTag(candidate).toLowerCase() === segment,
)
if (!locale) throw new Error(`Unknown locale "${segment}"`)
---

<HowToIndexPage locale={locale} />
