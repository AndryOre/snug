{
  "name": "@snug/site",
  "description": "Snug landing page (Astro)",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "astro": "astro",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "astro build && playwright test",
    "test:e2e:browserstack": "astro build && browserstack-node-sdk playwright test --config=playwright.browserstack.config.ts",
    "test:percy": "astro build && percy exec -- playwright test -c playwright.percy.config.ts",
    "test:container": "playwright test -c playwright.container.config.ts --grep-invert @visual",
    "test:visual": "bash scripts/visual.sh test",
    "test:visual:update": "bash scripts/visual.sh update",
    "i18n:status": "bun src/docs/i18n-status.ts",
    "lighthouse": "bash scripts/lighthouse-budget.sh"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@astrojs/starlight": "^0.42.5",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@workspace/ui": "workspace:*",
    "astro": "^7.3.5",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "^4.21.1",
    "sharp": "^0.35.5",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@percy/cli": "^1.32.11",
    "@percy/playwright": "^1.1.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "^5.0.4",
    "browserstack-node-sdk": "^1.73.2",
    "jsdom": "^30.1.1",
    "lighthouse": "^13.5.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
