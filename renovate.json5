{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
    ':semanticCommits',
    ':semanticCommitTypeAll(chore)',
    'helpers:pinGitHubActionDigests',
    'group:monorepos',
    'group:recommended',
  ],

  timezone: 'UTC',
  schedule: ['before 12pm on monday'],

  // Rate limits — low noise for solo dev
  prConcurrentLimit: 3,
  prHourlyLimit: 2,
  branchConcurrentLimit: 5,

  rangeStrategy: 'bump',
  // Main requires the PR branch to be up to date before merging
  // (strict_required_status_checks_policy in the main branch ruleset),
  // so automerge branches must be kept current, not just conflict-free
  rebaseWhen: 'behind-base-branch',

  // Wait 3 days before opening a PR — guards against supply-chain attacks on freshly published versions
  minimumReleaseAge: '3 days',

  labels: ['dependencies'],

  // Vulnerability source is osvVulnerabilityAlerts only — Dependabot alerts are
  // deliberately disabled (docs/adr/0001-public-repo-security-posture.md)
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    enabled: true,
    labels: ['Priority: Critical', 'Type: Security'],
    assignees: ['AndryOre'],
  },

  // Lockfile refresh — covers the bun workspaces and the root catalog
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 12pm on monday'],
  },

  // apps/site (Astro, @astrojs/*) needs no dedicated rule: its dependencies fall
  // under the dependencies/devDependencies and all non-major rules below, and
  // react/tailwind come from the root catalog groups
  packageRules: [
    {
      matchDepTypes: ['devDependencies'],
      semanticCommitScope: 'deps-dev',
    },
    {
      matchDepTypes: ['dependencies'],
      semanticCommitScope: 'deps',
    },

    {
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'all non-major',
      groupSlug: 'all-minor-patch',
    },

    // WXT framework bundle — keep these in sync
    {
      groupName: 'wxt',
      matchPackageNames: ['wxt', '@wxt-dev/**'],
    },
    {
      groupName: 'react',
      matchPackageNames: ['react', 'react-dom', '@types/react*'],
    },
    {
      groupName: 'base ui + lucide',
      matchPackageNames: ['@base-ui/react', 'lucide-react'],
    },
    // Catalog entries without a group of their own below move together: Renovate
    // bumps the root catalog once for every workspace that references them
    {
      groupName: 'workspace catalog',
      matchFileNames: ['package.json'],
      matchDepNames: ['cn', '@types/bun'],
    },
    {
      groupName: 'tailwindcss',
      matchPackageNames: [
        'tailwindcss',
        '@tailwindcss/**',
        'prettier-plugin-tailwindcss',
      ],
    },
    {
      groupName: 'eslint',
      matchPackageNames: [
        'eslint',
        'typescript-eslint',
        'eslint-plugin-*',
        'eslint-config-prettier',
        '@vitest/eslint-plugin',
      ],
    },
    {
      groupName: 'vitest',
      matchPackageNames: ['vitest', '@vitest/**'],
    },
    {
      groupName: 'type definitions',
      matchPackageNames: ['@types/**'],
    },

    {
      groupName: 'github-actions',
      matchManagers: ['github-actions'],
    },

    // Bun runtime is not managed via package.json engines — bump manually
    {
      matchPackageNames: ['bun'],
      matchManagers: ['npm'],
      enabled: false,
    },

    // OPT-IN AUTOMERGE — active: branch protection + required "CI passed" status check
    // are now enforced on main (AO-827, docs/adr/0001-public-repo-security-posture.md)
    // Uses 7-day release age (stricter than global 3-day) as extra supply-chain buffer
    {
      matchDepTypes: ['devDependencies'],
      matchUpdateTypes: ['patch', 'minor'],
      automerge: true,
      automergeType: 'pr',
      minimumReleaseAge: '7 days',
    },
    {
      matchManagers: ['github-actions'],
      matchUpdateTypes: ['patch', 'minor', 'digest', 'pinDigest'],
      automerge: true,
      automergeType: 'pr',
      minimumReleaseAge: '7 days',
    },
  ],
}
